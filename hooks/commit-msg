#!/bin/sh
# De-ASI-INTERFACE commit-msg hook
# Enforces conventional commit format: type(scope): description

MSG_FILE=$1
MSG=$(cat "$MSG_FILE")

PATTERN='^(feat|fix|docs|style|refactor|test|chore|perf|ci|build)(\([a-z0-9-]+\))?: .{3,}'

if ! echo "$MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "[BLOCKED] Commit message must follow Conventional Commits format:"
  echo "  type(scope): description"
  echo "  Example: feat(staking): add lock multiplier logic"
  echo ""
  exit 1
fi

echo "[OK] Commit message format valid."
exit 0
